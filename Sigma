local function createScriptButton(name, loaderFunc)
    local btn = Instance.new("TextButton", scroll)
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.BackgroundColor3 = ITEM_BG
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.BorderSizePixel = 0
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local btnStroke = Instance.new("UIStroke", btn)
    btnStroke.Color = Color3.fromRGB(40, 40, 40)
    btnStroke.Thickness = 1

    local lbl = Instance.new("TextLabel", btn)
    lbl.Size = UDim2.new(1, -20, 1, 0)
    lbl.Position = UDim2.fromOffset(15, 0)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 12
    lbl.TextColor3 = WHITE
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Text = name

    btn.MouseEnter:Connect(function()
        TS:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(25, 25, 25)}):Play()
        TS:Create(btnStroke, TweenInfo.new(0.2), {Color = ACCENT}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TS:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = ITEM_BG}):Play()
        TS:Create(btnStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(40, 40, 40)}):Play()
    end)

    btn.MouseButton1Click:Connect(function()
        setStatus("Loading " .. name .. "...", ACCENT)
        task.spawn(function()
            local ok, err = pcall(loaderFunc)
            if ok then
                setStatus(name .. " loaded!", WHITE)
                task.wait(1.5)
                sg.Enabled = false
            else
                setStatus("Error: " .. tostring(err), Color3.fromRGB(255, 80, 80))
            end
        end)
    end)
end

